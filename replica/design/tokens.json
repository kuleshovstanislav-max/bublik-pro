{
  "_about": "Bublik Graphite design tokens. Values are what the app ships (night.attheme via Tools/bublik/make_graphite_theme.py, BublikShapes, MessageDrawable, DialogCell). Check with: python3 contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#0e0e0e",
    "surface": "#1c1c1e",
    "surface-raised": "#242426",
    "surface-out": "#1e2a38",
    "surface-muted": "#2c2c2e",
    "border": "#2a2a2c",
    "text": "#f2f2f7",
    "text-muted": "#a1a1a8",
    "text-faint": "#8e8e93",
    "accent": "#2e9bf0",
    "accent-highlight": "#7aeaff",
    "on-accent": "#04223a",
    "warning": "#ff9f0a",
    "danger": "#ff453a",
    "success": "#30d158"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-raised"],
    ["text", "surface-out"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-muted"],
    ["text-faint", "surface", "large"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["accent", "surface-out", "ui"],
    ["warning", "bg"],
    ["warning", "surface"],
    ["danger", "surface"],
    ["success", "surface"],
    ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "Google Sans Flex (system, Pixel only, never bundled), fallback Roboto",
    "mono": "Roboto Mono"
  },
  "type": {
    "caption": {"size": 12, "line": 16, "weight": 500},
    "label": {"size": 13, "line": 16, "weight": 600, "note": "uppercase section labels, +0.06em"},
    "body": {"size": 16, "line": 22, "weight": 400},
    "name": {"size": 17, "line": 22, "weight": 500},
    "timer": {"size": 15, "line": 20, "weight": 500},
    "title": {"size": 20, "line": 26, "weight": 600},
    "display": {"size": 30, "line": 36, "weight": 800}
  },
  "space": [0, 4, 8, 12, 16, 24, 32],
  "radius": {"pill-small": 14, "bubble": 22, "card": 24, "pill": 999, "avatar": "9-wave cookie, depth 0.07"},
  "shadow": {
    "pill": "0 0.85dp 2.67dp rgba(0,0,0,.12), hairline rgba(255,255,255,.14)"
  },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "spring": "stiffness 500, damping ratio 0.6 (tab icons)"
  }
